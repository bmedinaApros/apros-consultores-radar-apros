# Copia este archivo a .env y ajusta. No subas .env al repositorio.
NODE_ENV=development
APP_URL=http://localhost:3000

# Conexión de la aplicación (rol con mínimos privilegios)
DATABASE_URL=postgres://radar_app:radar_app_dev@localhost:5432/radar_dev
# Conexión para migraciones (propietario de la base)
MIGRATE_DATABASE_URL=postgres://radar_owner:radar_dev@localhost:5432/radar_dev

# OBLIGATORIO, mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Dominios de Google Workspace autorizados (separados por coma)
AUTH_ALLOWED_DOMAINS=apros.pe
# Correos que reciben rol administrador en su primer ingreso (separados por coma)
INITIAL_ADMIN_EMAILS=

# Google OIDC (vacío en desarrollo local). Se crean en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Acceso de desarrollo: SOLO funciona con NODE_ENV=development. La app no arranca en producción si está en true.
DEV_LOGIN_ENABLED=true

# Modo local: entra directo, sin usuario ni clave (solo uso personal en tu equipo; no se permite en producción)
LOCAL_MODE=false

# Analizador web
CRAWLER_USER_AGENT="RadarAPROS/1.0 (+https://apros.pe; analisis comercial B2B)"
CRAWLER_ALLOWED_PORTS=80,443
CRAWLER_MAX_PAGES=8
CRAWLER_TIMEOUT_MS=10000
ANALYSIS_CACHE_DAYS=7
# PageSpeed Insights (opcional). Sin clave, la señal de rendimiento queda "no se pudo verificar".
PAGESPEED_API_KEY=

# Diagnósticos. Por defecto «rules»: plantillas y reglas, SIN IA y sin costo (no envía datos a nadie).
# Para usar IA (opcional): AI_PROVIDER=anthropic y una clave propia abajo. («disabled» y «simulated» son valores antiguos y equivalen a «rules».)
AI_PROVIDER=rules
# Clave de la API de Anthropic (console.anthropic.com). Nunca la subas al repositorio.
ANTHROPIC_API_KEY=
# Modelo configurable (por ejemplo claude-opus-5-5, claude-sonnet-5-5 o claude-haiku-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Investigación con Grok (opcional): busca el sitio web y los contactos públicos de cada empresa, con su fuente.
# Clave de API de xAI (pago por uso; una suscripción de la app no sirve). Vacío = no se usa y Radar solo adivina dominios.
XAI_API_KEY=
XAI_MODEL=grok-4.3
RESEARCH_PER_RUN=40
RESEARCH_MAX_USD_PER_RUN=3
