# Copia este archivo a .env y ajusta. No subas .env al repositorio.
NODE_ENV=development
APP_URL=http://localhost:3000

# Conexión de la aplicación (rol con mínimos privilegios)
DATABASE_URL=postgres://radar_app:radar_app_dev@localhost:5432/radar_dev
# Conexión para migraciones (propietario de la base)
MIGRATE_DATABASE_URL=postgres://radar_owner:radar_dev@localhost:5432/radar_dev

# OBLIGATORIO, mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
SESSION_SECRET=

# Dominios de Google Workspace autorizados (separados por coma)
AUTH_ALLOWED_DOMAINS=apros.pe
# Correos que reciben rol administrador en su primer ingreso (separados por coma)
INITIAL_ADMIN_EMAILS=

# Google OIDC (vacío en desarrollo local). Se crean en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Acceso de desarrollo: SOLO funciona con NODE_ENV=development. La app no arranca en producción si está en true.
DEV_LOGIN_ENABLED=true
