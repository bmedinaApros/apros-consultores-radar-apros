{
  "name": "radar-apros",
  "version": "0.1.0",
  "private": true,
  "description": "Radar APROS: detección semanal de oportunidades comerciales",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs up",
    "db:rollback": "node --env-file=.env scripts/migrate.mjs down",
    "db:seed": "tsx --env-file=.env scripts/seed-dev.ts",
    "audit:deps": "npm audit --audit-level=high",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "registry:import": "tsx --env-file=.env scripts/registry-import.ts",
    "registry:rubros": "tsx --env-file=.env scripts/registry-rubros.ts",
    "registry:search": "tsx --env-file=.env scripts/registry-search.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fontsource/questrial": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "node-pg-migrate": "9.0.0",
    "openid-client": "6.8.9",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.1",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "robots-parser": "3.0.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "3.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.1.0"
  }
}
